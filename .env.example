# Esempio di file per le variabili d'ambiente del progetto.
#
# COME USARLO:
# 1. Copia questo file e rinominalo in ".env" (nella stessa cartella, la root del progetto).
# 2. Compila i valori qui sotto con le credenziali del tuo progetto Supabase
#    (le trovi in Supabase -> Project Settings -> API).
# 3. Il file ".env" (quello vero, con i valori reali) NON va mai committato su git:
#    è già escluso tramite .gitignore.
#
# NOTA: le variabili devono iniziare con "VITE_" per essere accessibili
# nel codice frontend tramite import.meta.env (Vite espone solo le variabili
# con questo prefisso, per motivi di sicurezza).

# URL del progetto Supabase (es. https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chiave pubblica "anon" di Supabase (sicura da usare lato client,
# perché l'accesso ai dati resta comunque protetto dalle policy RLS)
VITE_SUPABASE_ANON_KEY=

# Chiave PUBBLICABILE di Stripe (mai quella segreta!), usata per inizializzare
# Stripe.js lato client. La trovi nella dashboard Stripe, in modalità Test:
# https://dashboard.stripe.com/test/apikeys (inizia con "pk_test_...")
VITE_STRIPE_PUBLISHABLE_KEY=
